<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.marcosbarbero.deskspace</groupId>
  <artifactId>deskspace-backend</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>deskspace-backend</name>
  <description>Desk booking API, generated from ../api/openapi.yaml</description>

  <properties>
    <java.version>21</java.version>
    <openapi.spec>${project.basedir}/../api/openapi.yaml</openapi.spec>
    <openapi-generator.version>7.10.0</openapi-generator.version>
    <spring-format.version>0.0.47</spring-format.version>
    <maven-checkstyle.version>3.6.0</maven-checkstyle.version>
    <checkstyle.version>12.3.1</checkstyle.version>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- PIT below 1.19 crashes its minion on JDK 21. -->
    <pitest.version>1.19.6</pitest.version>
    <!-- Managed by spring-boot-dependencies; named here because the individual
         testcontainers modules are not in its managed dependency list. -->
    <testcontainers.version>2.0.5</testcontainers.version>
    <!--
      What coverage does not count. Generated code always: it is not written
      here. JdbcBookings only in the default build, because the suite that
      exercises it needs Docker and the default build does not run it. The
      database profile drops that exclusion, so the adapter is measured by the
      run that can actually cover it.
    -->
    <jacoco.excludes>com/marcosbarbero/deskspace/booking/adapter/out/persistence/JdbcBookings.class,com/marcosbarbero/deskspace/shared/config/OutboxScheduling.class,com/marcosbarbero/deskspace/shared/event/outbox/JdbcOutbox.class,com/marcosbarbero/deskspace/shared/event/outbox/OutboxDomainEvents.class,com/marcosbarbero/deskspace/shared/event/outbox/ScheduledOutboxRelay.class</jacoco.excludes>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Persistence is opt in. These are on the compile path so the adapter builds,
      and nothing wires them up unless the postgres profile is active, so a clone
      with no Docker still goes green.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The starter, not flyway-core: Spring Boot 4 moved auto-configuration
         into per-technology modules, so flyway-core alone brings the library
         and no wiring, and migrations silently never run. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Required by code the generator emits. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>2.2.25</version>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.6</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Verifies pacts/ against this running service. The consumer declares what it
      depends on; this proves the provider still delivers it.
    -->
    <dependency>
      <groupId>au.com.dius.pact.provider</groupId>
      <artifactId>junit5spring</artifactId>
      <version>4.6.14</version>
      <scope>test</scope>
    </dependency>
    <!-- Package boundaries as a failing test rather than as a paragraph. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Tests tagged `database` need Docker, so they are off by default: a fresh
        clone must go green on any machine with a JDK. `-Pdatabase` opts in, and
        CI runs it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>database</excludedGroups>
        </configuration>
      </plugin>

      <!--
        Formatting is not a review topic here. It is applied by a tool and
        checked by the build, so nobody spends attention on it and no agent
        spends a token on it.
      -->
      <plugin>
        <groupId>io.spring.javaformat</groupId>
        <artifactId>spring-javaformat-maven-plugin</artifactId>
        <version>${spring-format.version}</version>
        <executions>
          <execution>
            <id>format-validate</id>
            <phase>validate</phase>
            <goals><goal>validate</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!--
        An explicit execution id and configLocation are load-bearing: a bare
        `checkstyle:check` silently runs Sun's default ruleset instead of this
        one and reports hundreds of violations nobody asked about.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>quality-checkstyle-validation</id>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <configLocation>src/checkstyle/quality-checkstyle.xml</configLocation>
              <includeTestSourceDirectory>false</includeTestSourceDirectory>
              <sourceDirectories>${project.build.sourceDirectory}</sourceDirectories>
              <failOnViolation>true</failOnViolation>
              <violationSeverity>warning</violationSeverity>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Coverage proves a line ran. Generated code is excluded: it is not written
        here, so covering it measures the generator rather than this repository.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <exclude>com/marcosbarbero/deskspace/api/**</exclude>
            <exclude>${jacoco.excludes}</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>prepare-package</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The contract is api/openapi.yaml. This generates the request and response
        types and the controller interfaces from it, into target/, so they are
        never edited by hand and never drift from the spec.
      -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${openapi.spec}</inputSpec>
              <generatorName>spring</generatorName>
              <!-- The wire model is not the domain model. The prefix keeps that
                   visible in every import instead of relying on package order. -->
              <modelNamePrefix>Api</modelNamePrefix>
              <apiPackage>com.marcosbarbero.deskspace.api</apiPackage>
              <modelPackage>com.marcosbarbero.deskspace.api.model</modelPackage>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <openApiNullable>false</openApiNullable>
                <skipDefaultInterface>true</skipDefaultInterface>
                <documentationProvider>none</documentationProvider>
                <annotationLibrary>none</annotationLibrary>
                <useJakartaEe>true</useJakartaEe>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The database tests, opted into: ./mvnw -Pdatabase verify -->
    <profile>
      <id>database</id>
      <properties>
        <!-- This run covers the JDBC adapter, so it is measured like everything
             else. Nothing is excluded twice. -->
        <jacoco.excludes>com/marcosbarbero/deskspace/api/**</jacoco.excludes>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- A tag nothing carries, rather than an empty element: an
                   empty value reads back as null and breaks any other plugin
                   that inspects surefire's configuration, PIT included. -->
              <excludedGroups>none</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Coverage proves a line ran. Mutation proves somebody would notice if it
      changed. Slower, so it is a profile rather than part of every build:
      ./mvnw -Pmutation verify
    -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.3</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.marcosbarbero.deskspace.booking.*</param>
                <param>com.marcosbarbero.deskspace.desk.*</param>
                <param>com.marcosbarbero.deskspace.availability.*</param>
              </targetClasses>
              <targetTests>
                <param>com.marcosbarbero.deskspace.*</param>
              </targetTests>
              <!-- Contract verification boots a server; it is not a unit-level
                   assertion and it dominates the runtime. -->
              <excludedTestClasses>
                <param>com.marcosbarbero.deskspace.contract.*</param>
              </excludedTestClasses>
              <mutationThreshold>80</mutationThreshold>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
            </configuration>
            <executions>
              <execution>
                <id>mutation-coverage</id>
                <phase>verify</phase>
                <goals><goal>mutationCoverage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
